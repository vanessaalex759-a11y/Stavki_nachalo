				ОбластьКтоИтогиГде.Параметры.ПотерОчки2 = ВыборкаГдеИгра.ПотерОчки;
				
				//ОбластьКтоИтогиНиз.Параметры.Заполнить(ВыборкаГдеИгра);
				ТабДок.Присоединить(ОбластьКтоИтогиГде);
				

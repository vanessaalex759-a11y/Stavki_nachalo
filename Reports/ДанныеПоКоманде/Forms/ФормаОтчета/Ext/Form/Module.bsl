&НаКлиенте
Процедура Предыдущая(Команда)
	стр		= МассивК.Индекс(МассивК.НайтиПоЗначению(выбКоманда));
	индекс	= ?(стр=0, КолКоманд-1, стр-1);	// 0..КолКоманд-1
	выбКоманда	= МассивК.Получить(индекс).Значение;
	СформироватьДанныеПоКоманде(выбКоманда)
КонецПроцедуры

&НаКлиенте
Процедура Следующая(Команда)
	стр		= МассивК.Индекс(МассивК.НайтиПоЗначению(выбКоманда));
	индекс	= ?(стр=КолКоманд-1, 0, стр+1);	// 0..КолКоманд-1
	выбКоманда	= МассивК.Получить(индекс).Значение;
	СформироватьДанныеПоКоманде(выбКоманда);
КонецПроцедуры


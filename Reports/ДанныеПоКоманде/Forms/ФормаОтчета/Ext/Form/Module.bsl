&НаСервере
Процедура ЗаполнитьРеквизитыОформленияСтрокНаФорме()

	//ОбъектДанные = ДанныеФормыВЗначение(Отчет, Тип("ПланВидовХарактеристикОбъект.ПланВидовХарактеристик1"));
	//ЗначениеИзХранилища = ОбъектДанные.ЦветПобеды.Получить();
	//ЦветПобеды = ЗначениеИзХранилища;
	
	//УсловноеОформление.Элементы
	
	стНастройкиЦвета = Константы.хзЦвета.Получить().Получить();
	
	Если Не стНастройкиЦвета = Неопределено И ТипЗнч(стНастройкиЦвета)=Тип("Структура") Тогда
		
		ЦветПобеды		= стНастройкиЦвета.ЦветПобеды;
		ЦветНичьи		= стНастройкиЦвета.ЦветНичьи;
		ЦветПоражения	= стНастройкиЦвета.ЦветПоражения;
		
		ЦветКомандДома	= стНастройкиЦвета.ЦветКомандДома;
		ЦветКомандВыезд	= стНастройкиЦвета.ЦветКомандВыезд;
		
	Иначе
		
		ЦветПобеды		= WebЦвета.ЦветМорскойВолныНейтральный;	//WebЦвета.Красный;
		ЦветНичьи		= WebЦвета.Оранжевый;					//WebЦвета.Зеленый;
		ЦветПоражения	= WebЦвета.Кирпичный;					//WebЦвета.СветлоГрифельноСиний;
		
		ЦветКомандДома	= WebЦвета.Оранжевый;
		ЦветКомандВыезд	= WebЦвета.ЗеленыйЛес;
		
	КонецЕсли;	
	
КонецПроцедуры


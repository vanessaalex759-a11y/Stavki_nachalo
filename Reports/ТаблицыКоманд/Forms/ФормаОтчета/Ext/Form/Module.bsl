Процедура ДВПриИзменении(Элемент)
	Обновить();
КонецПроцедуры

&НаКлиенте
Процедура Тур2Очистка(Элемент, СтандартнаяОбработка)
	
	Тур1 = 0;
	Тур2 = 0;
	
	Обновить();
	
КонецПроцедуры
&НаКлиенте
Процедура Тур2ПриИзменении(Элемент)
	
	Если Тур2 > 0 и Тур1 = 0 Тогда
		Тур1 = 1
	ИначеЕсли Тур2 < Тур1 Тогда
		Тур1 = Тур2
	КонецЕсли;	
	
КонецПроцедуры
&НаКлиенте
Процедура Тур1ПриИзменении(Элемент)
	
	Если Тур2 > 0 и Тур1 = 0 Тогда
		Тур1 = 1
	ИначеЕсли Тур2 < Тур1 Тогда
		Тур2 = Тур1
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ТабДокОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("Команда, Сезон, ДВ", Расшифровка, Сезон, ДВ);
	ОткрытьФорму("Отчет.ДанныеПоКоманде.Форма.ФормаОтчета", ПараметрыФормы);

КонецПроцедуры


&НаКлиенте
Процедура СезонПриИзменении(Элемент)
	
	Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура обрКнопкаВперед(Команда)
	
	Тур2 = 0;
	Тур1 = 0;
	Обновить()
		
КонецПроцедуры

&НаКлиенте
Процедура обрКнопкаНазад(Команда)
	
	Тур2 = ПоследнийТурСезона;
	Тур1 = 1;
	
	Обновить();
	
	Элементы.КнопкаВперед.Доступность = Истина;
	Элементы.КнопкаНазад.Доступность = Ложь
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененТекущийСезон" Тогда
		Сезон = омВызовИзКлиента.обПолучитьТекущийСезон()

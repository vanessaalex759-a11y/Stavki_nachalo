&НаКлиенте
Процедура ПрочитатьФайл_CSV()

	Объект.ДанныеФайла.Очистить();
	
	СпособЧтения = "ЧтениеТекста";//"ТекстовыйДокумент";
	Если СпособЧтения = "ТекстовыйДокумент" Тогда
		
		Текст = Новый ТекстовыйДокумент;
		Текст.Прочитать(Объект.ПутьКФайлу, КодировкаТекста.UTF8);
		КоличествоСтрок = Текст.КоличествоСтрок();
		
		Для НомерСтроки=2 По КоличествоСтрок Цикл
			
			ТекСтрока = Текст.ПолучитьСтроку(НомерСтроки);
			ЧастиСтроки = СтрРазделить(ТекСтрока, ";");
			
			Если ЧастиСтроки.Количество() < 3 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "В строке № " + НомерСтроки + " неверный формат";
				Сообщение.Сообщить();
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Объект.ДанныеФайла.Добавить();
			НоваяСтрока.Наименование = ЧастиСтроки[0];
			НоваяСтрока.НаименованиеПолное = ЧастиСтроки[1];
			НоваяСтрока.УНП = ЧастиСтроки[2];
			
		КонецЦикла;
		
	Иначе
		
		Текст = Новый ЧтениеТекста;
		Текст.Открыть(Объект.ПутьКФайлу, КодировкаТекста.UTF8);
		
		ТекСтрока = Текст.ПрочитатьСтроку();
		
		НомерСтроки = 1;
		
		Пока ТекСтрока <> Неопределено Цикл
			
			Если НомерСтроки = 1 Тогда
				НомерСтроки = НомерСтроки + 1;  
				ТекСтрока = Текст.ПрочитатьСтроку();
				Продолжить;
			КонецЕсли;
			
			ЧастиСтроки = СтрРазделить(ТекСтрока, ";");
			
			Если ЧастиСтроки.Количество() < 3 Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "В строке № " + НомерСтроки + " неверный формат";
				Сообщение.Сообщить();
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = Объект.ДанныеФайла.Добавить();
			НоваяСтрока.Наименование = ЧастиСтроки[0];
			НоваяСтрока.НаименованиеПолное = ЧастиСтроки[1];
			НоваяСтрока.УНП = ЧастиСтроки[2];
			
			ТекСтрока = Текст.ПрочитатьСтроку();  
			НомерСтроки = НомерСтроки + 1;
		
		КонецЦикла;
		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьФайл_XLS()
	
	Файл = Новый Файл(Объект.ПутьКФайлу);
	Расширение = Файл.Расширение;
	
	//получить двоичные данные файла
	ДанныеФайла = Новый ДвоичныеДанные(Объект.ПутьКФайлу);
	
	//поместить данные файла во врем. хранилище
	АдресДанных = ПоместитьВоВременноеХранилище(ДанныеФайла);
	
	//обработать файл на сервере
	ПрочитатьФайл_XLS_НаСервере(АдресДанных, Расширение);
	
КонецПроцедуры               

&НаСервере
Процедура ПрочитатьФайл_XLS_НаСервере(АдресДанных, Расширение)
	
	//сформировать имя временного файла
	ПутьКФайлуНаСервере = ПолучитьИмяВременногоФайла(Расширение);
	
	//получить данные файла из врем. хранилища
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресДанных);
	
	//записать данные файла в файловую систему сервера
	ДанныеФайла.Записать(ПутьКФайлуНаСервере);
	
	Объект.ДанныеФайла.Очистить();
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Прочитать(ПутьКФайлуНаСервере, СпособЧтенияЗначенийТабличногоДокумента.Значение);

	КоличествоСтрок = ТабДок.ВысотаТаблицы;
    КоличествоКолонок = 3;//ТабДок.ШиринаТаблицы;

	Для НомерСтроки=2 По КоличествоСтрок Цикл
		
		Наименование		= ТабДок.Область(НомерСтроки,1).Текст;
		НаименованиеПолное	= ТабДок.Область(НомерСтроки,2).Текст;
		УНП					= ТабДок.Область(НомерСтроки,3).Текст;
		
		Попытка
			ДатаРегистрации = ТабДок.Область(НомерСтроки,4).Значение;
		Исключение
			ДатаРегистрации = '00010101';
		КонецПопытки;
		     
		Если ПустаяСтрока(Наименование) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Объект.ДанныеФайла.Добавить();
		НоваяСтрока.Наименование = Наименование;
		НоваяСтрока.НаименованиеПолное = НаименованиеПолное;
		НоваяСтрока.УНП = УНП;
		
	КонецЦикла;
	
КонецПроцедуры // ПрочитатьФайл_XLS_НаСервере()

&НаКлиенте
Процедура ПрочитатьФайл_DBF()
	
	Объект.ДанныеФайла.Очистить();
	
	ФайлДБФ = Новый XBase;
	ФайлДБФ.ОткрытьФайл(Объект.ПутьКФайлу);
	
	Если НЕ ФайлДБФ.Первая() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "В выбранном файле нет данных";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;  

	Пока НЕ ФайлДБФ.ВКонце() Цикл
		
		НоваяСтрока = Объект.ДанныеФайла.Добавить();
		НоваяСтрока.Наименование	   = ФайлДБФ.NAME;
		НоваяСтрока.НаименованиеПолное = ФайлДБФ.FULL_NAME;
		НоваяСтрока.УНП				   = ФайлДБФ.UNP;
		
		ФайлДБФ.Следующая();

	КонецЦикла;
	
	ФайлДБФ.ЗакрытьФайл();

КонецПроцедуры


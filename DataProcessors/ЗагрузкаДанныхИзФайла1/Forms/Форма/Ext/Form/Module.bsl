&НаКлиенте
Процедура ПрочитатьФайлСаша(Команда)
		
Текст = Новый ЧтениеТекста("d:\Сезон 2019_2020.txt", КодировкаТекста.UTF8); 

Стр = Текст.ПрочитатьСтроку(); 
	
 // Прочитали 1 тур думаем как это грузить на форму
 Пока Стр <> Неопределено Цикл // строки читаются до символа перевода строки  

	 
// Получим номер тура строкой 

Если СтрДлина(Стр) = 5 Тогда
 НомерТура = Прав(Стр, 1);
 СтрокаБезНомерТура = СокрЛП(Лев(Стр, 4));
 НомерТураПолный = НомерТура + " " + СтрокаБезНомерТура;
ИначеЕсли  СтрДлина(Стр) = 6 Тогда
 НомерТура = Прав(Стр, 2);
 СтрокаБезНомерТура = Лев(Стр, 3);
 НомерТураПолный = НомерТура + " " + СтрокаБезНомерТура;
КонецЕсли;  
	 
// Убираем строчку где (Тур	Дата, время	Матч	Счет)	 
	 
	Если СтрНайти(Стр, "Тур") > 0 или СтрНайти(Стр, "Счет") > 0 Тогда 
		Стр = Текст.ПрочитатьСтроку(); 
		Продолжить;	
	КонецЕсли;
	// Убираем пробелы в строке слева и справа
	 Стр = СокрЛП(Стр); 
	 
	 // Получаем Дату
	 НашаДатаТекстНеправильный = Лев(Стр,10);  
	 Год = Прав(НашаДатаТекстНеправильный,4);
	 Месяц = Сред(НашаДатаТекстНеправильный,4,2);
	 День = Лев(НашаДатаТекстНеправильный,2);
	 НашаДатаСтрока = Год + Месяц + День;
	 НашаДата = Дата(НашаДатаСтрока);
	 //КомандаХозяев
	 СтрБезДаты = СокрЛП(Сред(Стр,11)); 
	 Счет = Прав(СтрБезДаты,3);
	 ЗнакТире = СтрНайти(СтрБезДаты, "–");	 
	 СтрКомандаХозяев = СокрЛП(Лев(СтрБезДаты, ЗнакТире-1)); 
	 
	  //КомандаГостей 
	 СтрБезСчетаИДаты = СокрЛП(Лев(СтрБезДаты,СтрДлина(СтрБезДаты)-3)); 
	 ЗнакТиреСправа = СтрНайти(СтрБезСчетаИДаты, "–",НаправлениеПоиска.СКонца);	 
	 СтрКомандаГостей = СокрЛП(Сред(СтрБезСчетаИДаты, ЗнакТире + 1)); 
     	 
	// Сезон строка
	 Сезон = СокрЛП(Объект.Сезоны);	
	 // Заполнили Табличную часть на форме
	 НоваяСтрока = Объект.ДанныеФайла1.Добавить();
	 НоваяСтрока.Сыгран = Истина;  
	 НоваяСтрока.Дата = НашаДата;
	 НоваяСтрока.Турнир = "РФПЛ";  
	 НоваяСтрока.КомандаХозяев = СтрКомандаХозяев;
	 НоваяСтрока.Счет = Счет;  
	 НоваяСтрока.КомандаГостей = СтрКомандаГостей; 
	 НоваяСтрока.КтоИграл = СтрБезСчетаИДаты; 
	 НоваяСтрока.Сезон = Сезон;
	 НоваяСтрока.Тур = НомерТураПолный;	 

#Область РазбитьТЧ

// Функция разбивает табличную часть на части по указанному количеству строк
// Возвращает массив табличных частей 

Функция РазбитьПоКоличествуСтрок(ИсходнаяТабличнаяЧасть, КоличествоСтрокВЧасти)
    
    Результат = Новый Массив;
    ТекущаяЧасть = Новый ТаблицаЗначений;
    
    // Копируем структуру исходной таблицы
    Для каждого Колонка Из ИсходнаяТабличнаяЧасть.Колонки Цикл
        ТекущаяЧасть.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
    КонецЦикла;
    
    Счетчик = 0;
    
    Для каждого Строка Из ИсходнаяТабличнаяЧасть Цикл
        НоваяСтрока = ТекущаяЧасть.Добавить();
        ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
        
        Счетчик = Счетчик + 1;
        
        Если Счетчик >= КоличествоСтрокВЧасти Тогда
            Результат.Добавить(ТекущаяЧасть);
            ТекущаяЧасть = Новый ТаблицаЗначений;
            
            // Копируем структуру снова
            Для каждого Колонка Из ИсходнаяТабличнаяЧасть.Колонки Цикл
                ТекущаяЧасть.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
            КонецЦикла;
            
            Счетчик = 0;
        КонецЕсли;
    КонецЦикла;
    
    // Добавляем последнюю часть, если в ней есть строки
    Если ТекущаяЧасть.Количество() > 0 Тогда
        Результат.Добавить(ТекущаяЧасть);
    КонецЕсли;
    
    Возврат Результат;  
	
	
КонецФункции


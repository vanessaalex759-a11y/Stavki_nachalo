Функция обДополнитьСтроку(Знач Парам, Длина, Символ = "0", Режим = 0) Экспорт
	
	// пример обДополнитьСтроку(2, 5)
	// параметр - число 2 преобр в строку длиной 5 ==> "00002"
	//
	// пример обДополнитьСтроку(8, 2, " ")
	// ==> " 8"
	
	Парам = ""+Парам;  // превращаем параметр в строку
	Добавить = Длина - СтрДлина(Парам);
	
	Если Добавить > 0  Тогда
		Добавок = "";
		Для Сч = 1 По Добавить Цикл
			Добавок = Добавок + Символ
		КонецЦикла;
		Парам = ?(Режим = 0, Добавок + Парам, Парам + Добавок)
	КонецЕсли;
	
	Возврат	Парам
	
КонецФункции // глДополнитьСтроку()

Функция обЧислоВСчет(Знач Парам) Экспорт
	
	// в РН.Счет не хранится симв. представление счета
	// Парам - число - ресурс РН
	// 1  - "0:1"
	// 0  - ""
	// 21 - "2:1"
	
	Если Парам <=0 Тогда Возврат ""	КонецЕсли;
	
	Если Парам =99 Тогда Возврат "0-0"	КонецЕсли;
	
	Ч1 = Цел(Парам/10);	
	Ч2 = Парам-Ч1*10;
	Возврат Строка(Ч1)+"-"+Строка(Ч2)
	
КонецФункции // обЧислоВСчет()

Функция обПолучитьСписокСезонов(Сезон1, Сезон2)
	
	СписокСезонов = Новый СписокЗначений;
	Если Сезон1.Пустая() Или Сезон2.Пустая() Тогда
		Возврат Справочники.Сезоны.ПустаяСсылка()
	ИначеЕсли Сезон1 = Сезон2 Тогда
		СписокСезонов.Добавить(Сезон2);
		Возврат СписокСезонов
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Сезоны.Ссылка КАК Сезон
	               |ИЗ
	               |	Справочник.Сезоны КАК Сезоны
	               |ГДЕ
	               |	Сезоны.ГодНачала >= &Код1
	               |	И Сезоны.ГодНачала <= &Код2
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Сезоны.Код";
	
	Запрос.УстановитьПараметр("Код1", Сезон1.ГодНачала);
	Запрос.УстановитьПараметр("Код2", Сезон2.ГодНачала);
	
	Результат = Запрос.Выполнить();
	Выборка	=	Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокСезонов.Добавить(Выборка.Сезон)
	КонецЦикла; 
	
	Возврат СписокСезонов
	
КонецФункции //


//Начало Codex 01.07.2026: техническая обработка перепроведения документов Тур
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Сезон) Тогда
		Сезон = Константы.ТекущийСезон.Получить();
	КонецЕсли;

	ТолькоПроведенные = Истина;

КонецПроцедуры

&НаКлиенте
Процедура Выполнить(Команда)

	Результат = ПерепровестиТурыНаСервере(Сезон, ДатаНачала, ДатаОкончания, ТолькоПроведенные);

	Сообщить("Перепроведение туров завершено. Всего: "
		+ Результат.Всего
		+ ", успешно: " + Результат.Успешно
		+ ", ошибок: " + Результат.Ошибок);

	Если Результат.Ошибок > 0 Тогда
		Сообщить(Результат.ОписаниеОшибок);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПерепровестиТурыНаСервере(Сезон, ДатаНачала, ДатаОкончания, ТолькоПроведенные) Экспорт

	ИспользоватьСезон = ЗначениеЗаполнено(Сезон);
	ИспользоватьДатуНачала = ЗначениеЗаполнено(ДатаНачала);
	ИспользоватьДатуОкончания = ЗначениеЗаполнено(ДатаОкончания);

	Если Не ИспользоватьСезон Тогда
		Сезон = Справочники.Сезоны.ПустаяСсылка();
	КонецЕсли;

	Если Не ИспользоватьДатуНачала Тогда
		ДатаНачала = Дата(1, 1, 1);
	КонецЕсли;

	Если Не ИспользоватьДатуОкончания Тогда
		ДатаОкончания = Дата(3999, 12, 31, 23, 59, 59);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Тур.Ссылка КАК Ссылка,
	|	Тур.Дата КАК Дата,
	|	Тур.Номер КАК Номер
	|ИЗ
	|	Документ.Тур КАК Тур
	|ГДЕ
	|	Тур.ПометкаУдаления = ЛОЖЬ
	|	И (&ТолькоПроведенные = ЛОЖЬ ИЛИ Тур.Проведен)
	|	И (&ИспользоватьСезон = ЛОЖЬ ИЛИ Тур.Сезон = &Сезон)
	|	И (&ИспользоватьДатуНачала = ЛОЖЬ ИЛИ Тур.Дата >= &ДатаНачала)
	|	И (&ИспользоватьДатуОкончания = ЛОЖЬ ИЛИ Тур.Дата <= &ДатаОкончания)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Тур.Дата,
	|	Тур.Номер";

	Запрос.УстановитьПараметр("ТолькоПроведенные", ТолькоПроведенные);
	Запрос.УстановитьПараметр("ИспользоватьСезон", ИспользоватьСезон);
	Запрос.УстановитьПараметр("Сезон", Сезон);
	Запрос.УстановитьПараметр("ИспользоватьДатуНачала", ИспользоватьДатуНачала);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ИспользоватьДатуОкончания", ИспользоватьДатуОкончания);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);

	Всего = 0;
	Успешно = 0;
	Ошибок = 0;
	ОписаниеОшибок = "";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Всего = Всего + 1;

		Попытка
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Успешно = Успешно + 1;
		Исключение
			Ошибок = Ошибок + 1;
			ОписаниеОшибок = ОписаниеОшибок
				+ "Тур " + Выборка.Номер
				+ " от " + Формат(Выборка.Дата, "ДФ=dd.MM.yyyy")
				+ ": " + ОписаниеОшибки()
				+ Символы.ПС;
		КонецПопытки;

	КонецЦикла;

	Возврат Новый Структура("Всего, Успешно, Ошибок, ОписаниеОшибок",
		Всего, Успешно, Ошибок, ОписаниеОшибок);

КонецФункции
